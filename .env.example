# RecoveryOS Environment Configuration Example
# Copy this file to .env: cp .env.example .env

# Database Configuration (Default: local SQLite database)
DATABASE_URL=sqlite:///./recoveryos.db

# Streamlit UI Backend API URL
RECOVERYOS_API_URL=http://localhost:8000

# LLM Configuration
USE_REAL_LLM=false
GROQ_API_KEY=your_groq_api_key_here
